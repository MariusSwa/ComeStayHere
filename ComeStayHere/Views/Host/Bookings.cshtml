    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<ComeStayHere.Models.Booking>
@using ComeStayHere.Models.Enums

@{
    ViewData["Title"] = "Booking Requests";
}

<div class="container mt-4">

    <h1>Booking Requests</h1>

    <p class="text-muted">
        Review booking requests for your properties.
    </p>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You currently have no booking requests.
        </div>
    }
    else
    {
        @foreach (var booking in Model)
        {
            <div class="card mb-3">
                <div class="card-body">

                    <h4>
                        @booking.Property?.Title
                    </h4>

                    <p>
                        <strong>Guest:</strong>
                        @booking.Guest?.Email
                    </p>

                    <p>
                        <strong>Check-in:</strong>
                        @booking.CheckInDate.ToShortDateString()
                    </p>

                    <p>
                        <strong>Check-out:</strong>
                        @booking.CheckOutDate.ToShortDateString()
                    </p>

                    <p>
                        <strong>Travelers:</strong>
                        @booking.NumberOfTravelers
                    </p>

                    <p>
                        <strong>Total:</strong>
                        @booking.TotalPrice.ToString("C")
                    </p>

                    <p>
                        <strong>Status:</strong>
                        @switch (booking.Status)
{
    case ComeStayHere.Models.Enums.BookingStatus.Pending:
        <span class="badge status-pending">
            Pending
        </span>
        break;

    case ComeStayHere.Models.Enums.BookingStatus.Approved:
        <span class="badge status-approved">
            Approved
        </span>
        break;

    case ComeStayHere.Models.Enums.BookingStatus.Rejected:
        <span class="badge status-rejected">
            Rejected
        </span>
        break;

    case ComeStayHere.Models.Enums.BookingStatus.CheckedIn:
        <span class="badge status-checkedin">
            Checked In
        </span>
        break;
}
                    </p>

                    @if (booking.Status == BookingStatus.Pending)
                    {
                        <div class="d-flex gap-2">

                            <form asp-action="ApproveBooking"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@booking.Id" />

                                <button type="submit"
                                        class="btn btn-success">
                                    Approve
                                </button>
                            </form>

                            <form asp-action="RejectBooking"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@booking.Id" />

                                <button type="submit"
                                        class="btn btn-danger">
                                    Reject
                                </button>
                            </form>

                        </div>
                    }

                </div>
            </div>
        }
    }

</div>
