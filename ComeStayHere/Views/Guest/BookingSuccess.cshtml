    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model ComeStayHere.Models.Booking

@{
    ViewData["Title"] = "Booking Requested";
}

<div class="container mt-4">

    <div class="alert alert-success">

        <h2>Booking Request Submitted</h2>

        <p>
            Your booking request for
            <strong>@Model.Property?.Title</strong>
            has been submitted to the Host.
        </p>

    </div>

    <h4>Booking Details</h4>

    <p>
        <strong>Check-in:</strong>
        @Model.CheckInDate.ToShortDateString()
    </p>

    <p>
        <strong>Check-out:</strong>
        @Model.CheckOutDate.ToShortDateString()
    </p>

    <p>
        <strong>Travelers:</strong>
        @Model.NumberOfTravelers
    </p>

    <p>
        <strong>Total Price:</strong>
        @Model.TotalPrice.ToString("C")
    </p>

    <p>
        <strong>Status:</strong>
        @Model.Status
    </p>

    <a asp-action="Index"
       class="btn btn-primary">
        Back to Properties
    </a>

</div>