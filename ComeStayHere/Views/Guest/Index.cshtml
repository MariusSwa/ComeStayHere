    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<ComeStayHere.Models.HostProperty>

@{
    ViewData["Title"] = "Browse Properties";
}

<div class="container mt-4">

    <h1>Find a Place to Stay</h1>

    <a asp-controller="Guest"
       asp-action="MyBookings"
       class="btn btn-outline-primary mb-3">
        My Bookings
    </a>

    <p class="text-muted">
        Browse available properties.
    </p>

    <form asp-controller="Guest"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div class="col-md-4">
            <label class="form-label">City</label>

            <input type="text"
                   name="city"
                   value="@ViewBag.City"
                   class="form-control"
                   placeholder="Enter city" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Property Type</label>

            <input type="text"
                   name="propertyType"
                   value="@ViewBag.PropertyType"
                   class="form-control"
                   placeholder="Apartment, House..." />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Guest"
               asp-action="Index"
               class="btn btn-secondary">
                Clear
            </a>

        </div>

    </form>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            There are currently no active properties available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var property in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100">

                        @if (property.PropertyImages.Any())
                        {
                            <img src="@property.PropertyImages.First().ImageUrl"
                                 class="card-img-top"
                                 style="height: 220px; object-fit: cover;"
                                 alt="@property.Title" />
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @property.Title
                            </h5>

                            <p class="card-text">
                                @property.City
                            </p>

                            <p class="card-text">
                                @property.PropertyType
                            </p>

                            <p class="card-text">
                                <strong>
                                    @property.PricePerNight.ToString("C")
                                </strong>
                                per night
                            </p>

                            <a asp-controller="Guest"
                               asp-action="Details"
                               asp-route-id="@property.Id"
                               class="btn btn-primary">
                                View Property
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
