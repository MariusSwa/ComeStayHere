    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<ComeStayHere.Data.ApplicationUser>

@{
    ViewData["Title"] = "SuperAdmin";
}

<div class="container mt-4">

    <h1>SuperAdmin Dashboard</h1>

    <p class="text-muted">
        Manage Guest to Admin promotions.
    </p>

    <hr />

    <h3>Guest Users</h3>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            There are currently no Guest users.
        </div>
    }
    else
    {
        <table class="table table-striped">

            <thead>
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>

                        <td>
                            @user.Email
                        </td>

                        <td>
                            @user.FirstName @user.LastName
                        </td>

                        <td>

                            <form asp-action="PromoteToAdmin"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@user.Id" />

                                <button type="submit"
                                        class="btn btn-primary">
                                    Promote to Admin
                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>
