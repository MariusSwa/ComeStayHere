@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<ComeStayHere.Models.HostApplication>

@{
    ViewData["Title"] = "Host Applications";
}

<div class="container mt-4">

    <h1>Pending Host Applications</h1>

    <p class="text-muted">
        Review Guest applications to become Hosts.
    </p>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            There are currently no pending Host applications.
        </div>
    }
    else
    {
        @foreach (var application in Model)
        {
            <div class="card mb-4">
                <div class="card-body">

                    <h4 class="card-title">
                        @application.Property?.Title
                    </h4>

                    <p>
                        <strong>Applicant:</strong>
                        @application.User?.Email
                    </p>

                    <p>
                        <strong>Description:</strong>
                        @application.Property?.Description
                    </p>

                    <p>
                        <strong>Price Per Night:</strong>
                        @application.Property?.PricePerNight.ToString("C")
                    </p>

                    <p>
                        <strong>Address:</strong>
                        @application.Property?.Address,
                        @application.Property?.City
                    </p>

                    <p>
                        <strong>Property Type:</strong>
                        @application.Property?.PropertyType
                    </p>

                    <p>
                        <strong>Application Date:</strong>
                        @application.ApplicationDate
                    </p>

                    @if (application.Property?.PropertyImages != null)
                    {
                        @foreach (var image in application.Property.PropertyImages)
                        {
                            <img src="@image.ImageUrl"
                                 alt="Property image"
                                 class="img-fluid rounded mb-3"
                                 style="max-height: 300px;" />
                        }
                    }

                </div>
            </div>

            <div class="mt-3 d-flex gap-2">

                <form asp-action="ApproveHostApplication"
                      method="post">
                    <input type="hidden"
                           name="id"
                           value="@application.Id" />

                    <button type="submit"
                            class="btn btn-success">
                        Approve
                    </button>
                </form>

                <form asp-action="RejectHostApplication"
                      method="post">
                    <input type="hidden"
                           name="id"
                           value="@application.Id" />

                    <button type="submit"
                            class="btn btn-danger">
                        Reject
                    </button>
                </form>

            </div>
        }
    }
</div>
