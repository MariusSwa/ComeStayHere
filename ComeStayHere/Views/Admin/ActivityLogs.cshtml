@model IEnumerable<ComeStayHere.Models.ActivityLog>

@{
    ViewData["Title"] = "Activity Logs";
}

<div class="container mt-4">

    <h1>Activity Logs</h1>

    <p class="text-muted">
        Monitor security and significant platform activity.
    </p>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No activity has been recorded yet.
        </div>
    }
    else
    {
        <table class="table table-striped">

            <thead>
                <tr>
                    <th>Date</th>
                    <th>User</th>
                    <th>Activity</th>
                    <th>Description</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var log in Model)
                {
                    <tr>
                        <td>
                            @log.Timestamp
                        </td>

                        <td>
                            @log.User?.Email
                        </td>

                        <td>
                            @log.ActivityType
                        </td>

                        <td>
                            @log.Description
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    }

</div>